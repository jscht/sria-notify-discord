{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "emulator": "firebase emulators:start --only functions",
    "dev": "concurrently \"npm run build:watch\" \"nodemon --watch lib --ext js --exec \\\"npm run emulator\\\"\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "register:commands": "tsx src/providers/discord/register-commands.ts"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/app/index.js",
  "dependencies": {
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^6.3.2",
    "playwright": "^1.47.1",
    "playwright-extra": "^4.3.6",
    "puppeteer": "^24.2.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.4",
    "typescript": "5.1"
  },
  "private": true
}
