{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "strict": true,
    "sourceMap": true,
    "outDir": "lib",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/common": ["src/common"],
      "@/common/*": ["src/common/*"],
      "@/features": ["src/features"],
      "@/features/*": ["src/features/*"],
      "@/ai": ["src/ai"],
      "@/ai/*": ["src/ai/*"],
      "@/providers/*": ["src/providers/*"],
      "@/crawlers/*": ["src/crawlers/*"],
      "@/mocks/*": ["src/mocks/*"],
      "@/services/*": ["src/services/*"],
      "@/events/*": ["src/events/*"],
      "@/app/*": ["src/app/*"],
      "@/test/*": ["src/test/*"]
    },
    "declaration": true,
    "declarationMap": true
  },
  "compileOnSave": true,
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
